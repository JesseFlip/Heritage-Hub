# All variables are optional — HeritageHub runs in demo mode (bundled sample
# events, no backend) with none of these set. Copy this file to .env.local
# and fill in what you need locally; for GitHub Pages deploys, set the same
# names as repository secrets (Settings → Secrets and variables → Actions)
# and the deploy workflow will pass them through at build time.

# Supabase project (organizer submissions, live DB-backed events, RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox tiles instead of the free OpenStreetMap default.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Ticketmaster Discovery API — powers the "Live" events feed. Called
# directly from the browser since static export has no server to keep a
# key secret behind; restrict the key to your domain in the Ticketmaster
# developer portal. Get a free key at https://developer.ticketmaster.com.
NEXT_PUBLIC_TICKETMASTER_API_KEY=

# Override the GitHub Pages base path (e.g. "" for a custom domain, where
# the site is served from the domain root instead of /<repo>/). Leave unset
# to auto-derive from GITHUB_REPOSITORY in CI, or "" for local dev.
NEXT_PUBLIC_BASE_PATH=
